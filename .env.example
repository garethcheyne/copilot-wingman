# Wingman — Configuration
# Copy this file to .env and fill in real values.
# Single source of truth for Docker, proxy, and web.

# Ports (change to avoid clashes with other services)
WEB_PORT=3000
PROXY_PORT=3200
POSTGRES_PORT=5440
REDIS_PORT=6379

# Security keys (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
INTERNAL_API_KEY=change-me
ENCRYPTION_KEY=change-me-32-char-hex
ADMIN_API_KEY=change-me

# Database & Redis (for local dev outside Docker)
DATABASE_URL=postgresql://wingman:password@localhost:5440/wingman
REDIS_URL=redis://localhost:6379

# Next.js
NEXT_PUBLIC_PROXY_URL=http://localhost:3200
NEXT_PUBLIC_API_KEY=<same as INTERNAL_API_KEY>

